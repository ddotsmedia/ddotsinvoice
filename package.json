{
  "name": "ddotsinvoice",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "docker-compose up",
    "dev:api": "pnpm --filter @ddotsinvoice/api start:dev",
    "dev:web": "pnpm --filter @ddotsinvoice/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @ddotsinvoice/db db:generate",
    "db:migrate": "pnpm --filter @ddotsinvoice/db db:migrate",
    "db:studio": "pnpm --filter @ddotsinvoice/db db:studio"
  },
  "devDependencies": {
    "@types/node": "20",
    "decimal.js": "^10.6.0",
    "tsx": "^4.23.15",
    "typescript": "5"
  }
}
