DATABASE_URL=postgres://ddots_app:changeme@localhost:5434/ddotsinvoice
# REQUIRED in production: ddots_admin role has BYPASSRLS — used by auth login and super-admin queries.
# Without this, all logins fail because ddots_app (DATABASE_URL) is subject to RLS on the users table.
# Run scripts/setup-db-roles.sh after migration to set passwords for both roles.
DATABASE_ADMIN_URL=postgres://ddots_admin:changeme@localhost:5434/ddotsinvoice
REDIS_URL=redis://localhost:6381
JWT_SECRET=change_me_32_chars_minimum
JWT_REFRESH_SECRET=change_me_32_chars_minimum
NODE_ENV=development
PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001
SENTRY_DSN=
S3_ENDPOINT=
S3_BUCKET=ddotsinvoice
S3_ACCESS_KEY=
S3_SECRET_KEY=

# DB role passwords — run scripts/setup-db-roles.sh after first migration (requires both)
DATABASE_ROLE_PASSWORD=<generate-strong-password>
DATABASE_ADMIN_ROLE_PASSWORD=<generate-strong-password>

# Invitations / email (optional: without SMTP_HOST the invite link is logged and returned to the admin)
WEB_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CORS_ORIGINS=http://localhost:3000

# Telr Payment Gateway (UAE) — get credentials from https://telr.com
TELR_STORE_ID=
TELR_AUTH_KEY=
COOKIE_DOMAIN=localhost
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=changeme
